# =============================================================================
# RFQ Management System - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# --- Django ---
# Generate a strong secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-real-secret-key
DEBUG=True

# --- Microsoft OAuth2 (Azure AD App Registration) ---
# Create an app at https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
MICROSOFT_CLIENT_ID=your-client-id-here
MICROSOFT_CLIENT_SECRET=your-client-secret-here
MICROSOFT_TENANT_ID=your-tenant-id-or-common

# --- AI Provider ---
# Which AI provider backs classification + extraction: 'anthropic' (default) or 'openai'.
# Set the matching API key below (leave the other blank).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5.4-nano
# Stronger model used only for the Round-2 image-details vision pass.
OPENAI_VISION_MODEL=gpt-5.4-mini
ANTHROPIC_VISION_MODEL=claude-sonnet-4-6

# --- Celery (Redis) ---
# Background worker that executes email pulls. Start it with:
#   celery -A config worker -l info
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Run tasks synchronously in-process (no worker needed) for local dev/tests:
# CELERY_TASK_ALWAYS_EAGER=true

# --- PostgreSQL (optional - uncomment to use instead of SQLite) ---
# DB_NAME=rfq_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# --- CORS / Allowed Hosts (production) ---
# ALLOWED_HOSTS=.example.com,api.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com

# --- Business Central ---
# BC_API_URL=https://api.businesscentral.dynamics.com/v2.0
# BC_COMPANY_NAME=your-company-name
# Master switch for automated Business Central sync during email ingestion.
# Disabled by default; re-enable via BC_SYNC_ENABLED=true.
# BC_SYNC_ENABLED=false
